# TEMPORARY TEST MODE: plain HTTP on the server's IP, while the hdvault.in domain is on hold.
# Login codes and session cookies travel unencrypted. Use only test accounts with dummy files.
#
# When hdvault.in is active again, replace the block below with the HTTPS block at the bottom,
# set COOKIE_SECURE=true and APP_ENV=production in .env, then run: docker compose up -d --build

:80 {
	encode zstd gzip

	# API requests: /api/auth/me goes to the backend as /auth/me.
	handle_path /api/* {
		reverse_proxy api:8000 {
			# Replace any X-Forwarded-For the browser sent, so the rate limiter sees the real client IP.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Everything else is the React app. Unknown paths return index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

