# Caddy gets and renews the HTTPS certificate for hdvault.in automatically.
# Requires: DNS for hdvault.in points to the server, and ports 80 and 443 are open.

hdvault.in {
	encode zstd gzip

	# Rejects request bodies over 11 MB before they reach the app. The app's own limit is 10 MB per file;
	# the extra 1 MB covers multipart form overhead.
	request_body {
		max_size 11MB
	}

	# API requests: /api/auth/me goes to the backend as /auth/me.
	handle_path /api/* {
		reverse_proxy api:8000 {
			# Replace any X-Forwarded-For the browser sent, so the rate limiter sees the real client IP.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Everything else is the React app. Unknown paths return index.html for client-side routes.
	# The Content-Security-Policy is set only on the app pages. API responses already get one from the backend.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com https://accounts.google.com https://apis.google.com; frame-src 'self' blob: https://challenges.cloudflare.com https://accounts.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

