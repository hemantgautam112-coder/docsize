# Copy this file to .env on the server and fill in real values. Never commit .env.

# Database (used by docker-compose)
POSTGRES_DB=docsize
POSTGRES_USER=docsize
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Generate with: openssl rand -base64 48
SECRET_KEY=change-me-to-at-least-32-random-characters

# Admins: comma-separated emails that become admins on login
ADMIN_EMAILS=you@example.com

# Email login codes (Gmail app password or another SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreplyemail2207@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreplyemail2207@gmail.com

# Google sign-in is on hold. Leave empty to keep it disabled.
GOOGLE_CLIENT_ID=

# Processed copies are deleted after this many days
DERIVED_RETENTION_DAYS=30
MOBILE_LOGIN_ENABLED=false

# Cloudflare Turnstile (sign-up security check). Create a managed widget for hdvault.in in the Cloudflare dashboard.
# The secret key stays on the server only. The site key is public and is built into the frontend.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Login codes: 6 digits, expire after 5 minutes, 3 wrong tries lock the address for 1 hour.
# At most 10 codes per address per day. These limits are set in backend/app/config.py.
# New accounts (first 24 hours) can upload 5 files and run 5 processes per day.
