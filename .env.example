# Copy this file to .env on the server and fill in real values. Never commit .env.

# Database (used by docker-compose)
POSTGRES_DB=docsize
POSTGRES_USER=docsize
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Generate with: openssl rand -base64 48
SECRET_KEY=change-me-to-at-least-32-random-characters

# Admins: comma-separated emails that become admins on login
ADMIN_EMAILS=you@example.com

# Email login codes (Gmail app password or another SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreplyemail2207@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreplyemail2207@gmail.com

# Google sign-in is on hold. Leave empty to keep it disabled.
GOOGLE_CLIENT_ID=

# Processed copies are deleted after this many days
DERIVED_RETENTION_DAYS=30
MOBILE_LOGIN_ENABLED=false
